rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // 応急処置：期限なしで全公開。
      // 次のステップで Firebase Auth を導入し、
      // allow read, write: if request.auth != null; などの制限をかけることを推奨します。
      // 既存のコレクション（全公開の応急処置）
      allow read, write: if true;
    }
    
    match /workflows/{workflowId} {
      // ワークフロー機能は認証済みユーザーのみ
      // 実運用では resource.data.requester_id == request.auth.uid などの詳細な制限を追加
      allow read, write: if request.auth != null;
    }
  }
}
